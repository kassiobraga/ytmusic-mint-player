{
  "icon-animation": {
    "type": "combobox",
    "default": "spin",
    "description": "Animação do ícone do YouTube Music na barra quando estiver tocando",
    "options": {
      "Girando como Vinil (Recomendado)": "spin",
      "Fixo Pulsando (Glow)": "pulse",
      "Estático": "none"
    }
  },
  "collapse-when-idle": {
    "type": "combobox",
    "default": "when-not-playing",
    "description": "Minimizar barrinha (mostrar apenas o ícone do YouTube Music)",
    "options": {
      "Quando não estiver tocando música (Pausado ou Fechado)": "when-not-playing",
      "Apenas quando o YouTube Music estiver fechado": "when-closed",
      "Sempre mostrar os botões Voltar / Play / Avançar": "never"
    }
  },
  "player-filter": {
    "type": "combobox",
    "default": "prefer-ytm",
    "description": "Filtro de reprodutor de mídia (MPRIS2)",
    "options": {
      "Priorizar YouTube Music / Navegador (Com fallback para qualquer player ativo)": "prefer-ytm",
      "Apenas YouTube Music": "only-ytm",
      "Qualquer Player de Mídia (Spotify, VLC, Navegador, etc.)": "any"
    }
  },
  "hover-delay-ms": {
    "type": "spinbutton",
    "default": 80,
    "min": 0,
    "max": 500,
    "step": 20,
    "units": "ms",
    "description": "Tempo de resposta ao passar o mouse (Hover) para abrir a janelinha"
  },
  "hover-close-grace-ms": {
    "type": "spinbutton",
    "default": 280,
    "min": 100,
    "max": 1000,
    "step": 20,
    "units": "ms",
    "description": "Tempo de tolerância ao tirar o mouse antes de fechar a janelinha"
  },
  "ytmusic-launch-url": {
    "type": "entry",
    "default": "auto",
    "description": "Comando personalizado (deixe 'auto' para detectar o app YouTube Music instalado no Linux Mint)"
  }
}
