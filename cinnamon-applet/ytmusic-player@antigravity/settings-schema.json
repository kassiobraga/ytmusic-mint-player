{
  "icon-animation": {
    "type": "combobox",
    "default": "spin",
    "description": "Animação do ícone do YouTube Music na barra quando estiver tocando",
    "options": {
      "Girando como Vinil (Recomendado)": "spin",
      "Fixo Pulsando (Glow)": "pulse",
      "Estático": "none"
    }
  },
  "collapse-when-idle": {
    "type": "combobox",
    "default": "when-no-track",
    "description": "Minimizar barrinha (mostrar apenas o ícone do YouTube Music)",
    "options": {
      "Quando não houver música ativa (Minimiza fechado, expande ao tocar/pausar)": "when-no-track",
      "Sempre que estiver pausado ou fechado (Só mostra botões tocando)": "when-not-playing",
      "Sempre mostrar os botões Voltar / Play / Avançar": "never"
    }
  },
  "chrome-profile": {
    "type": "combobox",
    "default": "auto",
    "description": "Perfil do Chrome PWA do YouTube Music ao clicar no ícone",
    "options": {
      "Automático (Detectar perfil ativo ou Default)": "auto",
      "Perfil Padrão (Default)": "Default",
      "Perfil 3 (Profile 3)": "Profile 3"
    }
  },
  "player-filter": {
    "type": "combobox",
    "default": "prefer-ytm",
    "description": "Filtro de reprodutor de mídia (MPRIS2)",
    "options": {
      "Priorizar YouTube Music / Navegador (Com fallback para qualquer player ativo)": "prefer-ytm",
      "Apenas YouTube Music": "only-ytm",
      "Qualquer Player de Mídia (Spotify, VLC, Navegador, etc.)": "any"
    }
  },
  "hover-delay-ms": {
    "type": "spinbutton",
    "default": 80,
    "min": 0,
    "max": 500,
    "step": 20,
    "units": "ms",
    "description": "Tempo de resposta ao passar o mouse (Hover) para abrir a janelinha"
  },
  "hover-close-grace-ms": {
    "type": "spinbutton",
    "default": 280,
    "min": 100,
    "max": 1000,
    "step": 20,
    "units": "ms",
    "description": "Tempo de tolerância ao tirar o mouse antes de fechar a janelinha"
  },
  "ytmusic-launch-url": {
    "type": "entry",
    "default": "auto",
    "description": "Comando personalizado (deixe 'auto' para abrir o PWA do YouTube Music)"
  }
}
